@Article{Alvarez1980,
  author    = {Alvarez, Luis W. and Alvarez, Walter and Asaro, Frank and Michel, Helen V.},
  journal   = {Science},
  title     = {Extraterrestrial {Cause} for the {Cretaceous}-{Tertiary} {Extinction}},
  year      = {1980},
  month     = jun,
  note      = {VZD 4},
  number    = {4448},
  pages     = {1095--1108},
  volume    = {208},
  abstract  = {Platinum metals are depleted in the earth's crust relative to their cosmic abundance; concentrations of these elements in deep-sea sediments may thus indicate influxes of extraterrestrial material. Deep-sea limestones exposed in Italy, Denmark, and New Zealand show iridium increases of about 30, 160, and 20 times, respectively, above the background level at precisely the time of the Cretaceous-Tertiary extinctions, 65 million years ago. Reasons are given to indicate that this iridium is of extraterrestrial origin, but did not come from a nearby supernova. A hypothesis is suggested which accounts for the extinctions and the iridium observations. Impact of a large earth-crossing asteroid would inject about 60 times the object's mass into the atmosphere as pulverized rock; a fraction of this dust would stay in the stratosphere for several years and be distributed worldwide. The resulting darkness would suppress photosynthesis, and the expected biological consequences match quite closely the extinctions observed in the paleontological record. One prediction of this hypothesis has been verified: the chemical composition of the boundary clay, which is thought to come from the stratospheric dust, is markedly different from that of clay mixed with the Cretaceous and Tertiary limestones, which are chemically similar to each other. Four different independent estimates of the diameter of the asteroid give values that lie in the range 10 ± 4 kilometers.},
  doi       = {10.1126/science.208.4448.1095},
  file      = {:Extraterrestrial Cause for the Cretaceous-Tertiary Extinction.pdf:PDF},
  publisher = {American Association for the Advancement of Science},
  url       = {https://www.science.org/doi/10.1126/science.208.4448.1095},
  urldate   = {2023-08-13},
}

 
@Article{Smit1980,
  author    = {Smit, J. and Hertogen, J.},
  journal   = {Nature},
  title     = {An extraterrestrial event at the {Cretaceous}–{Tertiary} boundary},
  year      = {1980},
  issn      = {1476-4687},
  month     = may,
  note      = {VZD 4},
  number    = {5762},
  pages     = {198--200},
  volume    = {285},
  abstract  = {Closely spaced samples from an uninterrupted calcareous pelagic sequence across the Cretaceous–Tertiary boundary reveal that the extinction of planktonic Foraminifera and nannofossils was abrupt without any previous warning in the sedimentary record, and that the moment of extinction was coupled with anomalous trace element enrichments, especially of iridium and osmium. The rarity of these two elements in the crust of the Earth indicates that an extraterrestrial source, such as the impact of a large meteorite may have provided the required amounts of iridium and osmium.},
  copyright = {1980 Springer Nature Limited},
  doi       = {10.1038/285198a0},
  file      = {:An extraterrestrial event at the Cretaceous–Tertiary boundary.pdf:PDF},
  keywords  = {Science, Humanities and Social Sciences, multidisciplinary, Science, multidisciplinary},
  language  = {en},
  publisher = {Nature Publishing Group},
  url       = {https://www.nature.com/articles/285198a0},
  urldate   = {2023-08-13},
}

 
@Article{Renne2013,
  author    = {Renne, Paul R. and Deino, Alan L. and Hilgen, Frederik J. and Kuiper, Klaudia F. and Mark, Darren F. and Mitchell, William S. and Morgan, Leah E. and Mundil, Roland and Smit, Jan},
  journal   = {Science},
  title     = {Time {Scales} of {Critical} {Events} {Around} the {Cretaceous}-{Paleogene} {Boundary}},
  year      = {2013},
  month     = feb,
  note      = {VZD 4},
  number    = {6120},
  pages     = {684--687},
  volume    = {339},
  abstract  = {Mass extinctions manifest in Earth's geologic record were turning points in biotic evolution. We present 40Ar/39Ar data that establish synchrony between the Cretaceous-Paleogene boundary and associated mass extinctions with the Chicxulub bolide impact to within 32,000 years. Perturbation of the atmospheric carbon cycle at the boundary likely lasted less than 5000 years, exhibiting a recovery time scale two to three orders of magnitude shorter than that of the major ocean basins. Low-diversity mammalian fauna in the western Williston Basin persisted for as little as 20,000 years after the impact. The Chicxulub impact likely triggered a state shift of ecosystems already under near-critical stress.},
  doi       = {10.1126/science.1230492},
  file      = {:Time Scales of Critical Events Around the Cretaceous-Paleogene Boundary.pdf:PDF},
  publisher = {American Association for the Advancement of Science},
  url       = {https://www.science.org/doi/10.1126/science.1230492},
  urldate   = {2023-08-13},
}

 
@Article{Watson1953,
  author     = {Watson, J. D. and Crick, F. H. C.},
  journal    = {Nature},
  title      = {Molecular {Structure} of {Nucleic} {Acids} - {A} {Structure} for {Deoxyribose} {Nucleic} {Acid}},
  year       = {1953},
  issn       = {1476-4687},
  month      = apr,
  note       = {VZD 5},
  number     = {4356},
  pages      = {737--738},
  volume     = {171},
  abstract   = {The determination in 1953 of the structure of deoxyribonucleic acid (DNA), with its two entwined helices and paired organic bases, was a tour de force in X-ray crystallography. But more significantly, it also opened the way for a deeper understanding of perhaps the most important biological process. In the words of Watson and Crick: "It has not escaped our notice that the specific pairing that we have postulated immediately suggests a possible copying mechanism for the genetic material." [Obituary of Francis Crick: Nature 430, 845-847 (2004); obituary of Maurice Wilkins: Nature 431, 922 (2004)]},
  copyright  = {1953 Springer Nature Limited},
  doi        = {10.1038/171737a0},
  file       = {:Molecular Structure of Nucleic Acids - A Structure for Deoxyribose Nucleic Acid.pdf:PDF},
  keywords   = {Science, Humanities and Social Sciences, multidisciplinary, Science, multidisciplinary},
  language   = {en},
  publisher  = {Nature Publishing Group},
  shorttitle = {Molecular {Structure} of {Nucleic} {Acids}},
  url        = {https://www.nature.com/articles/171737a0},
  urldate    = {2023-08-13},
}

 
@Article{Navarro2022,
  author     = {Navarro, Bruno A. and Ghilardi, Aline M. and Aureliano, Tito and Díaz, Verónica Díez and Bandeira, Kamila L. N. and Cattaruzzi, André G. S. and Iori, Fabiano V. and Martine, Ariel M. and Carvalho, Alberto B. and Anelli, Luiz E. and Fernandes, Marcelo A. and Zaher, Hussam},
  journal    = {Ameghiniana},
  title      = {A {New} {Nanoid} {Titanosaur} ({Dinosauria}: {Sauropoda}) from the {Upper} {Cretaceous} of {Brazil}},
  year       = {2022},
  issn       = {0002-7014, 1851-8044},
  month      = sep,
  note       = {VZD 2},
  number     = {5},
  pages      = {317--354},
  volume     = {59},
  abstract   = {Los saurópodos titanosaurios son conocidos por mostrar una notable disparidad de tamaño corporal, con algunos taxones famosos por acercarse al cenit del tamaño corporal de un vertebrado terrestre. En este trabajo se describe un nuevo titanosaurio – Ibirania parva gen. et sp. nov. – del Cretácico Superior (Santoniano–Campaniano) de la Formación São José do Rio Preto de la Cuenca Bauru, el cual representa uno de los saurópodos más pequeños conocidos hasta la fecha. El nuevo taxón se puede diagnosticar gracias a siete autapomorfías y tenía una longitud corporal estimada de 5.7 m. Los análisis histológicos y de microtomografía computarizada muestran que este nuevo taxón está representado por individuos esqueléticamente maduros, que habrían alcanzado la madurez somática antes de la muerte. Los análisis filogenéticos han recuperado la inclusión del nuevo taxón dentro de Saltasaurinae, un clado previamente conocido por formas de pequeño tamaño. Ibirania parva gen. et sp. nov. arroja nueva información indicando que la disminución del tamaño corporal en algunos titanosaurios podría estar impulsado por escenarios ecofisiográficos recurrentes, presentes en América del Sur antes del pico de diversidad alcanzado por el grupo durante el Campaniano–Maastrichtiano.},
  doi        = {10.5710/AMGH.25.08.2022.3477},
  file       = {:A New Nanoid Titanosaur (Dinosauria Sauropoda) from the Upper Cretaceous of Brazil.pdf:PDF},
  publisher  = {Asociación Paleontológica Argentina},
  shorttitle = {A {New} {Nanoid} {Titanosaur} ({Dinosauria}},
  url        = {https://bioone.org/journals/ameghiniana/volume-59/issue-5/AMGH.25.08.2022.3477/A-New-Nanoid-Titanosaur-Dinosauria--Sauropoda-from-the-Upper/10.5710/AMGH.25.08.2022.3477.full},
  urldate    = {2023-08-23},
}

@MastersThesis{Bolotsky2013,
  author   = {Ivan Bolotsky},
  school   = {Jilin University},
  title    = {Tyrannosaurid Dinosaurs (Coelurosauria) from Upper Cretaceous of Amur/Heilongjiang Area},
  year     = {2013},
  note     = {VZD 3 1/2},
  abstract = {Amur/Heilongjiang area is a unique border area between Russia and China, where several very rich Late Cretaceous dinosaurs’localities were discovered, mainly represented by the Blagoveschensk and Kundur in Russian side, and Jiayin and Wulaga in China’s side.Palynological analysis documented the dinosaur-bearing sediments of these localities belonging to the Udurchukan and Yuliangze formations which are synchronous (Markevich&Bugdaeva2001a,2001b; Sun et al.,2007; Bolotsky et al.,2009; Sun et al.,2011). The age is considered as the early-middle Maastrichtian according to Markevich et al.(2006), and as the late Maastrichtian according to Godefroit et al.(2004) and Nichols and Johnson (2008).For over100years research history, excavation work in Amur/Heilongjiang area brings abundant finds of different taxa of dinosaurs, turtles, crocodiles and mammals. More than90%of discovered material belongs to Late Cretaceous dominating animals-large, herbivorous dinosaurs of Hadrosauridae family, with rare and fragmentary carnivorous dinosaur remains (Tyrannosaurids in particularly) extracted occasionally.The present thesis, with enough data and preliminary research results, is begining to further uncover the knowledge on the carnivorous dinosaurs in the Amur/Heilongjiang River area, which would be more significant for better understanding the paleoecosystem including the dinosaurs. The description of all tyrannosaurid collection of IGNM FEB RAS (Russia) is presented for the first time. Material consists of76isolated, shed teeth crowns and several elements of postcranial skeleton. Teeth come from different parts of the jaw and demonstrate different size, preservation and unequal degree of taxonomic utility. Postcranial remains represented by caudal vertebrae and digit bones.Being the centerpiece of this work, isolated teeth is characterized by a group of numerical parameters, with methods of its measurement are presented by the works of many vertebrate paleontologists. Careful analysis of the data regarding to each tooth brings large amount of new information regarding size, tooth wear and replacement, feeding behavior and taphonomy. This information bears key significance for taxonomy, paleoecology and paleobiogeography of Tyrannosaurids and its place in the Cretaceous paleofaunas of Amur/Heilongjiang River area.On the basis of realized research, brief comparison with material from Northeast China, North America and Mongolia is presented for the first time. Matching with rare tyrannosaurid remains from Jiayin locality is important for further correlation of the Upper Cretaceous between Far Eastern Russia and Northeast China.In sum, detail study of tyrannosaurid remains of Amur/Heilongjiang Region is a stage in cooperative dinosaur research of North East Asia. It can help to clarify possibly ways of settling, evolutionary process of specific animal groups, and history of dinosaur complex organization in Far East of Russia, Northeast China, Mongolia and western North-America.},
  url      = {https://m.dissertationtopic.net/doc/1669403},
}

 
@Article{Allentoft2012,
  author     = {Allentoft, Morten E. and Collins, Matthew and Harker, David and Haile, James and Oskam, Charlotte L. and Hale, Marie L. and Campos, Paula F. and Samaniego, Jose A. and Gilbert, M. Thomas P. and Willerslev, Eske and Zhang, Guojie and Scofield, R. Paul and Holdaway, Richard N. and Bunce, Michael},
  journal    = {Proceedings of the Royal Society B: Biological Sciences},
  title      = {The half-life of {DNA} in bone: measuring decay kinetics in 158 dated fossils},
  year       = {2012},
  month      = oct,
  note       = {VZD 5},
  number     = {1748},
  pages      = {4724--4733},
  volume     = {279},
  abstract   = {Claims of extreme survival of DNA have emphasized the need for reliable models of DNA degradation through time. By analysing mitochondrial DNA (mtDNA) from 158 radiocarbon-dated bones of the extinct New Zealand moa, we confirm empirically a long-hypothesized exponential decay relationship. The average DNA half-life within this geographically constrained fossil assemblage was estimated to be 521 years for a 242 bp mtDNA sequence, corresponding to a per nucleotide fragmentation rate (k) of 5.50 × 10–6 per year. With an effective burial temperature of 13.1°C, the rate is almost 400 times slower than predicted from published kinetic data of in vitro DNA depurination at pH 5. Although best described by an exponential model (R2 = 0.39), considerable sample-to-sample variance in DNA preservation could not be accounted for by geologic age. This variation likely derives from differences in taphonomy and bone diagenesis, which have confounded previous, less spatially constrained attempts to study DNA decay kinetics. Lastly, by calculating DNA fragmentation rates on Illumina HiSeq data, we show that nuclear DNA has degraded at least twice as fast as mtDNA. These results provide a baseline for predicting long-term DNA survival in bone.},
  doi        = {10.1098/rspb.2012.1745},
  file       = {:The half-life of DNA in bone - measuring decay kinetics in 158 dated fossils.pdf:PDF},
  keywords   = {aDNA, decay kinetics, DNA degradation, DNA half-life},
  publisher  = {Royal Society},
  shorttitle = {The half-life of {DNA} in bone},
  url        = {https://royalsocietypublishing.org/doi/10.1098/rspb.2012.1745},
  urldate    = {2023-08-23},
}

 
@Article{Pawlicki1966,
  author    = {Pawlicki, R. and Korbel, A. and Kubiak, H.},
  journal   = {Nature},
  title     = {Cells, {Collagen} {Fibrils} and {Vessels} in {Dinosaur} {Bone}},
  year      = {1966},
  issn      = {1476-4687},
  month     = aug,
  note      = {VZD 5},
  number    = {5049},
  pages     = {655--657},
  volume    = {211},
  abstract  = {COLLAGEN has been found in mummified human remains several thousand years old, and in mastodon bones preserved under permafrost conditions. It has been stated that bone fragments after glacier preservation had all the appearances of a fresh bone1. Studies on Pleistocene bones have demonstrated that it is also possible to observe collagen and other organic materials in a fossil bone2,3. Electron micrographs of fossil bones of a deer-like animal from the Miocene (25 million years old) revealed collagen fibrils and the intact walls of canaliculi4. There have also been reports of striated muscle fibres, epithelial cells and melanophores being found in tissues of specimens from the Eocene (40 million years old) deposits of Geiseltal (eastern Germany)5. Furthermore, electron microscope investigations of patches of almost completely demineralized bone of a dinosaur from the Upper Trias (200 million years old), and the dermal armour of Devonian ostracoderms, have revealed a fibrillar structure, while a further examination of the same material showed a mixture of mineral and collagen patterns6. Analysis of fishes from the Middle Devonian (380 million years old) has indicated that degradation products of collagen can still be recognized. More recently7,8, it has been demonstrated that fossil dentine and bone-like tissues in Devonian ostracoderms can be decalcified and sectioned on a microtome. The presence in these tissues of polysaccharides as well as collagen has been indicated.},
  copyright = {1966 Springer Nature Limited},
  doi       = {10.1038/211655a0},
  file      = {:Cells, Collagen Fibrils and Vessels in Dinosaur Bone.pdf:PDF},
  keywords  = {Science, Humanities and Social Sciences, multidisciplinary, Science, multidisciplinary},
  language  = {en},
  publisher = {Nature Publishing Group},
  url       = {https://www.nature.com/articles/211655a0},
  urldate   = {2023-08-23},
}

 
@Article{Schweitzer2005a,
  author    = {Schweitzer, Mary H. and Wittmeyer, Jennifer L. and Horner, John R. and Toporski, Jan K.},
  journal   = {Science},
  title     = {Soft-{Tissue} {Vessels} and {Cellular} {Preservation} in {Tyrannosaurus} rex},
  year      = {2005},
  month     = mar,
  note      = {VZD 5},
  number    = {5717},
  pages     = {1952--1955},
  volume    = {307},
  abstract  = {Soft tissues are preserved within hindlimb elements of Tyrannosaurus rex (Museum of the Rockies specimen 1125). Removal of the mineral phase reveals transparent, flexible, hollow blood vessels containing small round microstructures that can be expressed from the vessels into solution. Some regions of the demineralized bone matrix are highly fibrous, and the matrix possesses elasticity and resilience. Three populations of microstructures have cell-like morphology. Thus, some dinosaurian soft tissues may retain some of their original flexibility, elasticity, and resilience.},
  doi       = {10.1126/science.1108397},
  file      = {:Soft-Tissue Vessels and Cellular Preservation in Tyrannosaurus rex.pdf:PDF},
  publisher = {American Association for the Advancement of Science},
  url       = {https://www.science.org/doi/10.1126/science.1108397},
  urldate   = {2023-08-23},
}

 
@Article{Cano1993,
  author    = {Cano, Raúl J. and Poinar, Heridrik N. and Pieniazek, Norman J. and Acra, Aftim and Poinar, George O.},
  journal   = {Nature},
  title     = {Amplification and sequencing of {DNA} from a 120–135-million-year-old weevil},
  year      = {1993},
  issn      = {1476-4687},
  month     = jun,
  note      = {VZD 5},
  number    = {6429},
  pages     = {536--538},
  volume    = {363},
  abstract  = {DNA has been successfully isolated from both fossilized plant1 and animal tissues2–6. The oldest material, dated as 25–40 million years old (Tertiary), was obtained from amber-entombed bees4,5 and termites6. Tissues from both these insects yielded DNA of good quality, which could be amplified by the polymerase chain reaction (PCR) and subsequently sequenced, including the genes encoding 18S ribosomal RNA5,6 and 16S rRNA6. We report here the extraction of DNA from a 120–135-million-year-old weevil (Nemonychidae, Coleoptera) found in Lebanese amber, PCR amplification of segments of the 18S rRNA gene and the internal transcribed spacer, and the corresponding nucleotide sequences of their 315- and 226-base-pair fragments, respectively. These sequen-ces were used for preliminary phylogenetic analysis of the nemonychid's sequence with three extant coleopterans: Lecontellus pinicola (Nemonychidae), Hypera brunneipennis (Curculionidae) and the mealworm Tenebrio molitor (Tenebrionidae), and two extant dipterans: the fruitfly Drosophila melanogaster (Drosophilidae) and mosquito Aedes albopictus (Culicidae) for the purpose of ascertaining the origin of the extracted and amplified DNA. The results revealed that the PCR-amplifted material is that of the extinct nemonychid weevil. This represents the oldest fossil DNA ever extracted and sequenced, extending by 80 million years the age of any previously reported DNA4–6.},
  copyright = {1993 Springer Nature Limited},
  doi       = {10.1038/363536a0},
  file      = {:Amplification and sequencing of DNA from a 120–135-million-year-old weevil.pdf:PDF},
  keywords  = {Science, Humanities and Social Sciences, multidisciplinary, Science, multidisciplinary},
  language  = {en},
  publisher = {Nature Publishing Group},
  url       = {https://www.nature.com/articles/363536a0},
  urldate   = {2023-08-23},
}

 
@Article{Xing2016,
  author    = {Xing, Lida and McKellar, Ryan C. and Xu, Xing and Li, Gang and Bai, Ming and Persons, W. Scott and Miyashita, Tetsuto and Benton, Michael J. and Zhang, Jianping and Wolfe, Alexander P. and Yi, Qiru and Tseng, Kuowei and Ran, Hao and Currie, Philip J.},
